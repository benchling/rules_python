    name = "file_mode_remove_stale_umbrella_stale_dep",
    deps = [":widget"],
)

py_library(
    name = "consumer",
    srcs = ["consumer.py"],
    deps = [":file_mode_remove_stale_umbrella_stale_dep"],
)
